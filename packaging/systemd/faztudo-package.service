# User service installed by the faztudo package under /usr/lib/systemd/user.
# Enable it with: systemctl --user enable --now faztudo
# Logs: journalctl --user -u faztudo -f
[Unit]
Description=faztudo workspace for people and agent CLIs
After=network.target

[Service]
Type=simple
ExecStart=/usr/bin/faztudo serve --no-open
Restart=on-failure
RestartSec=3
# Agent runs are child processes in their own process groups. Stop only the
# daemon on restart; it reattaches to runs that are still alive.
KillMode=process
# Agent CLIs are found on PATH, as in a login shell.
Environment=PATH=%h/.local/bin:%h/.grok/bin:%h/.kimi-code/bin:%h/.opencode/bin:/usr/local/bin:/usr/bin:/bin

[Install]
WantedBy=default.target
